#!/usr/bin/env bash

set -xeuo pipefail

mkdir -p "${SRCDIR}/cache"

if [ ! -e "${SRCDIR}/cache/crane" ] ; then
	CRANE_URL="$("${SRCDIR}/ghcurl" https://api.github.com/repos/google/go-containerregistry/releases/latest | jq -rc --arg arch "$(arch | sed "s/aarch/arm/")" '.assets[] | select(.name=="go-containerregistry_Linux_" + $arch + ".tar.gz") | .browser_download_url')"
	"${SRCDIR}/ghcurl" "${CRANE_URL}" -Lo /dev/stdout | tar -xvzf - -C "${SRCDIR}/cache" --owner=0 --group=0 --no-same-owner --no-same-permissions crane
fi

if [ ! -e "${SRCDIR}/cache/ublue-brew" ] ; then
	"${SRCDIR}/cache/crane" export ghcr.io/ublue-os/brew:latest | tar -xvf - -C "${SRCDIR}/cache" system_files
	mv "${SRCDIR}/cache/system_files" "${SRCDIR}/cache/ublue-brew"
fi
