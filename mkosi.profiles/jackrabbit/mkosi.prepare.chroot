#!/usr/bin/env bash

set -xeuo pipefail

mkdir -p "${SRCDIR}/cache"

if [ ! -e "${SRCDIR}/cache/oras" ] ; then
	ORAS_VERSION="$(curl --retry 3 --retry-delay 2 --retry-max-time 60 -fsSL https://api.github.com/repos/oras-project/oras/releases/latest| jq -rc .tag_name)"
	ORAS_URL="$(curl --retry 3 --retry-delay 2 --retry-max-time 60 -fsSL https://api.github.com/repos/oras-project/oras/releases/latest | jq -rc --arg tag_name "${ORAS_VERSION#v}" --arg arch "$(arch | sed "s/aarch/arm/;s/x86_64/amd64/")" '.assets[] | select(.name=="oras_" + $tag_name + "_linux_" + $arch + ".tar.gz") | .browser_download_url')"
	curl --retry 3 --retry-delay 2 --retry-max-time 60 -fsSLo /dev/stdout "${ORAS_URL}"	| tar -xvzf - -C "${SRCDIR}/cache" --owner=0 --group=0 --no-same-owner --no-same-permissions oras
fi

if [ ! -e "${SRCDIR}/cache/linux-ogc" ] ; then
	"${SRCDIR}/cache/oras" pull ghcr.io/opengamingcollective/kernel-packages-fedora:latest-fc44
	mkdir -p "${SRCDIR}/cache/linux-ogc"
	mv *.rpm "${SRCDIR}/cache/linux-ogc/"
fi

if [ ! -e "${SRCDIR}/cache/valve-audio" ] ; then
	curl --retry 3 --retry-delay 2 --retry-max-time 60 -fsSLo /dev/stdout https://steamdeck-packages.steamos.cloud/archlinux-mirror/jupiter-main/os/x86_64/steamdeck-dsp-1.00-1-any.pkg.tar.zst | tar --zstd -xvf - -C "${SRCDIR}/cache" --owner=0 --group=0 --no-same-owner --no-same-permissions usr/lib/firmware/amd usr/share/alsa/ucm2/conf.d
	mkdir -p "${SRCDIR}/cache/valve-audio"
	mv "${SRCDIR}/cache/usr/lib/firmware/amd" "${SRCDIR}/cache/valve-audio/sof_fw"
	mv "${SRCDIR}/cache/usr/share/alsa/ucm2/conf.d/sof-nau8821-max" "${SRCDIR}/cache/valve-audio"
	rm -rf "${SRCDIR}/cache/usr"
fi
